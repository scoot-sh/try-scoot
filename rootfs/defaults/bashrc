# try-scoot default bashrc (MIT): history, completion, starship, welcome.
# Interactive shells only; sourced by ~/.bash_profile too (foot runs bash
# as a non-login interactive shell, so this is the hot path: keep it fast,
# no forks except the starship init it exists to run).

# Non-interactive shells (scp, rsync, scripts): nothing to do.
case $- in
  *i*) ;;
  *) return ;;
esac

# History: big, shared across sessions, no duplicates.
HISTCONTROL=ignoreboth:erasedups
HISTSIZE=5000
HISTFILESIZE=10000
shopt -s histappend checkwinsize 2>/dev/null

# Completion: the nixpkgs bash-completion package when present.
if [ -r /usr/share/bash-completion/bash_completion ]; then
  # shellcheck source=/dev/null
  . /usr/share/bash-completion/bash_completion
fi

# Prompt: the look's starship config (ginger palette, Nerd glyphs matching
# the shipped FiraCode Nerd Font). Explicit STARSHIP_CONFIG wins.
if [ -z "${STARSHIP_CONFIG:-}" ] && [ -r "$HOME/.config/starship.toml" ]; then
  export STARSHIP_CONFIG="$HOME/.config/starship.toml"
fi
if command -v starship >/dev/null 2>&1; then
  eval "$(starship init bash)"
fi

# First-terminal welcome: once per terminal session (child shells inherit
# TRY_SCOOT_WELCOMED), off with TRY_SCOOT_NO_WELCOME=1. Pure builtins.
if [ -z "${TRY_SCOOT_NO_WELCOME:-}" ] && [ -z "${TRY_SCOOT_WELCOMED:-}" ] && [ -r /defaults/welcome.sh ]; then
  export TRY_SCOOT_WELCOMED=1
  # shellcheck source=/dev/null
  . /defaults/welcome.sh
fi

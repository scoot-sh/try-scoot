#!/bin/bash
# noVNC in front of wayvnc, as abc: websockify proxy + static file server.
# Browser at http://host:6080/ lands on the desktop with no client install.
RUNTIME="${XDG_RUNTIME_DIR:-/run/user/911}"
PORT="${NOVNC_PORT:-6080}"
LISTEN="${NOVNC_LISTEN:-0.0.0.0}"
VNC_PORT="${VNC_PORT:-5900}"

WEBDIR="$RUNTIME/novnc-web"
if [ ! -f "$WEBDIR/vnc.html" ]; then
  rm -rf "$WEBDIR"
  mkdir -p "$WEBDIR"
  cp -rL /usr/share/webapps/novnc/. "$WEBDIR"/
  cat > "$WEBDIR/index.html" <<'HTML'
<!DOCTYPE html>
<html><head><meta charset="utf-8">
<meta http-equiv="refresh" content="0; url=vnc.html?autoconnect=true&amp;resize=scale&amp;reconnect=true">
<title>try-scoot</title></head>
<body><p><a href="vnc.html?autoconnect=true&amp;resize=scale&amp;reconnect=true">Open the desktop</a></p></body></html>
HTML
fi

echo "[novnc] http://$LISTEN:$PORT/ -> localhost:$VNC_PORT" >&2
exec s6-setuidgid abc websockify --web "$WEBDIR" "$LISTEN:$PORT" "localhost:$VNC_PORT"

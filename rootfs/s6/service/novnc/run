#!/bin/bash
# noVNC in front of wayvnc, as abc: wsbridge proxy + static file server.
# Browser at http://host:6080/ lands on the desktop with no client install.
# Auth (when VNC_PASSWORD is set) happens end-to-end at the RFB layer inside
# the proxied stream: noVNC prompts for the password, wsbridge never sees
# it. The dial target is derived from the same VNC_LISTEN/VNC_PORT as the
# wayvnc listener (see ../wayvnc/run), so the browser path tracks the knob.
set -u
RUNTIME="${XDG_RUNTIME_DIR:-/run/user/911}"
PORT="${NOVNC_PORT:-6080}"
LISTEN="${NOVNC_LISTEN:-0.0.0.0}"
VNC_PORT="${VNC_PORT:-5900}"
VNC_LISTEN="${VNC_LISTEN:-localhost}"

# Same TARGET rule as ../wayvnc/run: a VNC_LISTEN already carrying a port
# (or socket path) is used as-is, else :$VNC_PORT is appended.
case "$VNC_LISTEN" in
  *:*|*.sock) TARGET="$VNC_LISTEN" ;;
  *) TARGET="$VNC_LISTEN:$VNC_PORT" ;;
esac
# Map the listen-side TARGET to something dialable: wildcard addresses are
# not dialable, so dial localhost on the same port; a socket path has no
# TCP dial target, so refuse loudly instead of dialing the wrong port.
if [[ "$TARGET" == *.sock ]]; then
  echo "[novnc] FATAL: VNC_LISTEN=$VNC_LISTEN is a socket path, which the browser bridge cannot dial -- unset it or use a host[:port]" >&2
  exit 1
fi
case "$TARGET" in
  0.0.0.0:*)
    DIAL="localhost:${TARGET#0.0.0.0:}"
    ;;
  '[::]:'*)
    DIAL="localhost:${TARGET##*:}"
    ;;
  *)
    DIAL="$TARGET"
    ;;
esac

WEBDIR="$RUNTIME/novnc-web"
if [ ! -f "$WEBDIR/vnc.html" ]; then
  rm -rf "$WEBDIR"
  mkdir -p "$WEBDIR"
  cp -rL /usr/share/webapps/novnc/. "$WEBDIR"/
  cat > "$WEBDIR/index.html" <<'HTML'
<!DOCTYPE html>
<html><head><meta charset="utf-8">
<meta http-equiv="refresh" content="0; url=vnc.html?autoconnect=true&amp;resize=scale&amp;reconnect=true">
<title>try-scoot</title></head>
<body><p><a href="vnc.html?autoconnect=true&amp;resize=scale&amp;reconnect=true">Open the desktop</a></p></body></html>
HTML
fi

echo "[novnc] http://$LISTEN:$PORT/ -> $DIAL" >&2
exec s6-setuidgid abc wsbridge -web "$WEBDIR" -listen "$LISTEN:$PORT" -target "$DIAL"
